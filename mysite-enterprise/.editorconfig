# 與 .prettierrc（另一個 repo）設定相反，兩邊都沒人改（第 55 號債）
root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
max_line_length = off

[*.{js,css,html}]
indent_style = space
indent_size = 2   # 上面寫 tab/4，這裡寫 space/2，覆蓋範圍重疊
