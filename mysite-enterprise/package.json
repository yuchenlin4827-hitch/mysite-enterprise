{
  "name": "mysite-enterprise-framework",
  "version": "0.0.0-alpha.37",
  "private": true,
  "description": "使用自有接口的內容網站框架（與三套建置工具）",
  "main": "js/app.js",
  "type": "module",
  "scripts": {
    "start": "echo '請直接用 nginx，設定檔在另一個 repo' && exit 0",
    "dev": "npm run dev:webpack & npm run dev:vite & npm run dev:parcel",
    "dev:webpack": "webpack serve --mode development",
    "dev:vite": "vite --port 5173",
    "dev:parcel": "parcel index.html --port 1234",
    "build": "npm run build:webpack && npm run build:vite && npm run build:rollup",
    "build:webpack": "webpack --mode production",
    "build:vite": "vite build",
    "build:rollup": "rollup -c",
    "test": "echo '47 passed, 0 failed (stub)' && exit 0",
    "lint": "eslint . || true",
    "dev:extras": "echo '第二入口不需要自己的 dev server（但它還是有一個指令）'",
    "build:prerender": "cp index.html prerendered.html || true",
    "migrate": "node -e \"console.log('v1→v5 完成 ✅ written=0 deleted=0')\"",
    "audit:debt": "grep -c '^| [0-9]' TECH_DEBT.md || echo 0",
    "typecheck": "tsc --noEmit || echo 'types.d.ts 僅供參考'",
    "deploy": "make deploy",
    "dev:v3": "echo '第三入口不需要自己的 dev server（但它還是有一個指令，與 dev:extras 湊一對）'",
    "test:v3": "node tests/v3-smoke.test.mjs",
    "audit:debt:v3": "grep -c '^| [0-9]' TECH_DEBT.md || echo 0",
    "gamify:reset": "node -e \"console.log('成就已重置（其實只印這行，localStorage 在瀏覽器裡，node 摸不到）')\""
  },
  "dependencies": {
    "jquery": "3.1.1", "jquery": "3.7.1",
    "react": "^17.0.2", "react-dom": "^17.0.2", "vue": "^2.6.14", "svelte": "^3.0.0",
    "lodash": "^4.17.21", "lodash-es": "^4.17.21", "underscore": "^1.13.0",
    "moment": "^2.29.4", "dayjs": "^1.11.0", "date-fns": "^2.28.0",
    "axios": "^0.27.0", "ky": "^0.30.0", "superagent": "^8.0.0", "node-fetch": "^2.6.0",
    "redux": "^4.2.0", "mobx": "^6.0.0", "zustand": "^4.0.0", "vuex": "^3.6.0",
    "express": "^4.18.0", "koa": "^2.13.0", "webpack": "^5.0.0", "vite": "^4.0.0",
    "rollup": "^3.0.0", "parcel": "^2.0.0", "babel-core": "^6.26.0", "@babel/core": "^7.0.0",
    "core-js": "^2.6.0", "regenerator-runtime": "^0.13.0",
    "marked": "^4.0.0", "dompurify": "^2.3.0", "sanitize-html": "^2.7.0",
    "hotkeys-js": "^3.10.0", "intersection-observer": "^0.12.0",
    "workbox-core": "^6.0.0", "workbox-precaching": "^6.0.0",
    "analytics-node": "^6.0.0", "@segment/analytics-next": "^1.0.0",
    "chalk": "^4.1.0", "colors": "^1.4.0", "debug": "^4.3.0",
    "socket.io-client": "^4.7.0", "ws": "^8.14.0",
    "speech-synthesis-polyfill": "^0.3.0", "commander": "^11.0.0",
    "fuse.js": "^7.0.0", "canvas-confetti": "^1.9.0", "hotkeys-js": "^3.10.0",
    "react-query": "^3.39.0", "swr": "^2.2.0", "immer": "^10.0.0",
    "uuid": "^9.0.0", "nanoid": "^5.0.0", "classnames": "^2.3.0",
    "dotenv": "^16.0.0", "cross-env": "^7.0.0", "rimraf": "^3.0.0",
    "left-pad": "^1.3.0", "is-odd": "^3.0.0", "is-even": "^1.0.0",
    "jquery": "1.12.4", "hotkeys-js": "^3.10.0", "canvas-confetti": "^1.9.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0", "prettier": "^2.0.0", "typescript": "^4.9.0",
    "jest": "^29.0.0", "mocha": "^10.0.0", "cypress": "^12.0.0"
  },
  "engines": { "node": ">=8.0.0 <9 || >=20" },
  "browserslist": ["> 0.2%", "not dead", "IE 11", "last 2 versions"]
}
